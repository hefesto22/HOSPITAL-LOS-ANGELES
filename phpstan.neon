includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - tests

    # Piso del proyecto: nivel 7 (§6.1). Máximo disponible: 10.
    # Subir a 8 cuando el dominio madure; 9 para dinero y expediente.
    level: 7

    excludePaths:
        - app/Filament/Resources/*/Pages/*
        - bootstrap/cache/*
        # Migración publicada por Spatie Permission. Es archivo vendor que
        # el paquete mantiene; verificada contra el stub de la v8.
        - database/migrations/2026_02_20_053238_create_permission_tables.php
        # NOTA: la migración de activity_log YA NO se excluye. Se reescribió
        # a mano para el esquema de activitylog 5 (las tres migraciones v4 se
        # consolidaron en una), así que es código nuestro y se analiza.

    ignoreErrors:
        # ── Filament v5 — magic methods en Schema/Form/Table builders ───────
        # v5 es v4 sobre Livewire 4: la API de Schemas y Actions unificadas
        # no cambió, así que estas exclusiones siguen aplicando igual.
        - identifier: missingType.iterableValue
          path: app/Filament/*

        - identifier: missingType.parameter
          path: app/Filament/Resources/ActivityLogResource.php

        # Los Resources heredados pasan $record sin tipo a los callbacks.
        # Es API documentada de Filament: en runtime $record es Model.
        - identifier: method.notFound
          paths:
              - app/Filament/Resources/Users/*
              - app/Filament/Resources/ActivityLogResource.php
        - identifier: property.notFound
          paths:
              - app/Filament/Resources/Users/*
              - app/Filament/Resources/ActivityLogResource.php

        # ── Eloquent magic ──────────────────────────────────────────────────
        - '#Access to an undefined property App\\Models\\.*::\$.*#'

        # ── Pest 5 magic ────────────────────────────────────────────────────
        # $this, test(), pest()->extend() y expect() son globals mágicos que
        # PHPStan no resuelve sin el plugin de Pest.
        - identifier: variable.undefined
          path: tests/*
        - identifier: method.notFound
          path: tests/*
        - identifier: method.staticCall
          path: tests/*

        # ── Seeders ─────────────────────────────────────────────────────────
        # ?->command es defensivo: el comando puede ser null.
        - identifier: nullsafe.neverNull
          path: database/seeders/*
        # env() en seeders es válido: corren en setup, no en runtime cacheado.
        - identifier: larastan.noEnvCallsOutsideOfConfig
          path: database/seeders/*

        # ── Branding del panel parametrizado por env ─────────────────────────
        - identifier: larastan.noEnvCallsOutsideOfConfig
          path: app/Providers/Filament/AdminPanelProvider.php

        # ── Modelos: User extiende Authenticatable de Laravel ────────────────
        # La covarianza de PHPDoc entre fillable/hidden de la base y los
        # nuestros es ruido: Laravel los define como list<string> implícito.
        - identifier: property.phpDocType
          path: app/Models/*

        # method_exists() defensivo para cuando el trait se aplique a otros
        # modelos además de User.
        - identifier: function.alreadyNarrowedType
          path: app/Traits/HasAuditFields.php

        # Tables/Schemas de Filament reciben Model desde el query builder
        # genérico; no se puede tipar $record dentro de cierres anónimos.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\(Model|Builder)<.*>::(hasRole|visibleTo)\(\)\.#'

        # config/filesystems.php es archivo de Laravel, no nuestro.
        - identifier: argument.type
          path: config/filesystems.php

    # Solo opciones válidas en PHPStan 2.x:
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
