{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "grupo-olympo/sihla",
    "type": "project",
    "description": "SIHLA — Sistema Integral Hospital Los Ángeles. PHP 8.5 + Laravel 13 + Filament v5 + PostgreSQL 18 + Redis 8. Multi-sede, replicable a otras clínicas, con normativa hondureña (ISV/RTN/CAI/ARSA).",
    "keywords": ["laravel", "filament", "postgresql", "honduras", "hospital", "his", "sihla"],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "^5.7",
        "laravel/framework": "^13.25",
        "laravel/horizon": "^5.33 || ^6.0",
        "laravel/tinker": "^3.0.2",
        "maatwebsite/excel": "^4.0",
        "marcelorodrigo/filament-barcode-scanner-field": "^1.1",
        "predis/predis": "^2.4 || ^3.0",
        "sentry/sentry-laravel": "^4.27",
        "spatie/browsershot": "^5.4",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel-lang/common": "^6.7 || ^7.0",
        "laravel/boost": "^2.5",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6 || ^9.0",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Domain\\": "app/Domain/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('.env.testing') || copy('env.testing.example', '.env.testing');\"",
            "@php artisan key:generate",
            "@php artisan storage:link",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#a78bfa\" \"php artisan serve\" \"php artisan horizon\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --parallel"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:check": [
            "@php vendor/bin/pint --test"
        ],
        "stan": [
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "rector": [
            "@php vendor/bin/rector process --dry-run"
        ],
        "rector:fix": [
            "@php vendor/bin/rector process"
        ],
        "security": [
            "@composer audit --abandoned=report"
        ],
        "ci": [
            "@security",
            "@lint:check",
            "@stan",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.8"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
