# ─────────────────────────────────────────────────────────────────
# SIHLA — Sistema Integral Hospital Los Ángeles
#
# Plantilla VERSIONADA. Sin secretos reales, nunca.
# Si agrego una variable al código y no la agrego aquí, rompo el
# deploy de mañana (§7.4).
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# APLICACIÓN
# ─────────────────────────────────────────────────────────────────
APP_NAME="Hospital Los Ángeles"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hospital-los-angeles.test

# Honduras no tiene horario de verano (§7.5).
APP_TIMEZONE=America/Tegucigalpa

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Identificador único de esta instalación. Prefija Redis, cache,
# cookie de sesión y contenedores Docker. Otra clínica cambia esto
# y COMPOSE_PROJECT_NAME, y no toca nada más (§1.1).
APP_SLUG=hospital_los_angeles
APP_BRAND_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# LOGGING — stack JSON + Sentry para errores en producción
# ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL 18, puerto dedicado del proyecto
# ─────────────────────────────────────────────────────────────────
# 5432/6379, 5442/6389 y 5443/6390 ya están ocupados por otros
# proyectos en esta Mac. Este proyecto usa 5444/6391 (§7.2).
#
# ⚠️ Antes de CUALQUIER comando destructivo se verifica puerto Y
# nombre de base. 5444 + hospital_los_angeles = local. Otra cosa = alto.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5444
DB_DATABASE=hospital_los_angeles
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# ─────────────────────────────────────────────────────────────────
# REDIS — cache, sesión, colas y locks distribuidos
# ─────────────────────────────────────────────────────────────────
# phpredis (extensión C) en vez de predis: Herd y el runner de CI ya
# la traen, y bajo carga real de hospital la diferencia de latencia
# por request es medible (§13). predis queda instalado como respaldo.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6391
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ⚠️ EXPLÍCITO A PROPÓSITO. Laravel 13 cambió los separadores de
# prefijo de "_" a "-": dejarlo al default invalida cache y sesión
# en el deploy y desloguea al turno completo (§6.3.2).
REDIS_PREFIX="${APP_SLUG}_"

# ─────────────────────────────────────────────────────────────────
# CACHE / SESSION / QUEUE — todo sobre Redis
# ─────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX="${APP_SLUG}_cache"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ⚠️ EXPLÍCITO A PROPÓSITO — mismo motivo que REDIS_PREFIX (§6.3.2).
SESSION_COOKIE="${APP_SLUG}_session"

# Laravel 13 pasa a "json" por defecto. Lo fijamos explícito en json
# porque este proyecto NO tiene sesiones vivas que invalidar y json
# evita deserializar objetos PHP desde el store (§6.3.1, §14).
SESSION_SERIALIZATION=json

QUEUE_CONNECTION=redis
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX="${APP_SLUG}_horizon:"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─────────────────────────────────────────────────────────────────
# CORREO
# ─────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hospitallosangeles.hn"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# ALMACENAMIENTO S3-COMPATIBLE — backups y archivos grandes
# ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────────
# OBSERVABILIDAD — Sentry
# ─────────────────────────────────────────────────────────────────
# ⚠️ send_default_pii DEBE quedar en false: este sistema maneja datos
# clínicos y un breadcrumb con nombre de paciente sale del país (§14).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ─────────────────────────────────────────────────────────────────
# BROWSERSHOT — PDFs vía Chromium headless
# ─────────────────────────────────────────────────────────────────
# Herd/macOS: dejar vacíos, autodetecta.
# Producción Linux: rutas absolutas a chromium-browser y node.
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_PATH=
BROWSERSHOT_NO_SANDBOX=false

# ─────────────────────────────────────────────────────────────────
# SUPER-ADMIN INICIAL — consumido por AdminUserSeeder
# ─────────────────────────────────────────────────────────────────
# OBLIGATORIO cambiar ADMIN_PASSWORD antes de producción.
# Si está vacío en producción, el seeder FALLA a propósito.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME="Administrador"

# ─────────────────────────────────────────────────────────────────
# DOCKER COMPOSE — consumidas por docker-compose.yml
# ─────────────────────────────────────────────────────────────────
# COMPOSE_PROJECT_NAME=hla → contenedores hla_postgres / hla_redis
COMPOSE_PROJECT_NAME=hla
COMPOSE_POSTGRES_PORT=5444
COMPOSE_REDIS_PORT=6391

# Local: password vacío + trust, puerto atado a 127.0.0.1.
# ⚠️ PRODUCCIÓN: password fuerte + COMPOSE_POSTGRES_AUTH=scram-sha-256.
# Es la ÚNICA pieza del entorno sin paridad con producción (§7.1).
COMPOSE_POSTGRES_PASSWORD=
COMPOSE_POSTGRES_AUTH=trust

# ─────────────────────────────────────────────────────────────────
# VITE
# ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
