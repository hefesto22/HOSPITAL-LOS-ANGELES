# ─────────────────────────────────────────────────────────────────
# SIHLA — PLANTILLA DE CONFIGURACIÓN DE TESTS
#
# ⚠️ ESTE archivo (.env.testing.example) SÍ va en git.
#    El .env.testing que sale de acá NO — está en .gitignore.
#
#    Se copia idéntico en los dos lados:
#        cp .env.testing.example .env.testing
#
# .env.testing es la ÚNICA fuente de la config de tests (§7.4);
# phpunit.xml solo lleva lo mínimo indispensable.
#
# El runner de GitHub Actions publica Postgres en 5444 y Redis en
# 6391 A PROPÓSITO, para que este mismo archivo sirva en la Mac y en
# CI sin un solo `sed` que se pueda desincronizar.
#
# PROHIBIDO poner un secreto real acá. Solo valores de bases
# desechables que se destruyen en cada corrida.
# ─────────────────────────────────────────────────────────────────

APP_NAME="Hospital Los Ángeles (test)"
APP_ENV=testing
APP_KEY=base64:8dqAvKZm5wYqPHDqU3xbnjkKuGRAzmQqpNCHVaZfnZs=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Tegucigalpa

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_HN

APP_MAINTENANCE_DRIVER=file
APP_SLUG=hospital_los_angeles_test
APP_BRAND_NAME="${APP_NAME}"

# Hash barato: la suite crea cientos de usuarios y bcrypt 12 la
# vuelve tres veces más lenta sin agregar una sola garantía.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────
# BASE DE DATOS — MISMO MOTOR Y MISMA VERSIÓN MAYOR QUE PRODUCCIÓN
# ─────────────────────────────────────────────────────────────────
# NUNCA SQLite (§7.1). Un test verde en SQLite que falla en Postgres
# es peor que no tener test: da confianza falsa sobre CHECK, índices
# parciales, JSONB, CTE, FOR UPDATE y EXCLUDE USING gist.
# Hay un test guardia que revienta la suite si alguien cambia esto.
#
# pest --parallel crea hospital_los_angeles_test_1..N — por eso el
# usuario necesita CREATEDB (§7.2).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5444
DB_DATABASE=hospital_los_angeles_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

# ─────────────────────────────────────────────────────────────────
# REDIS — instancia real, bases altas para no pisar dev
# ─────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6391
REDIS_DB=13
REDIS_CACHE_DB=14
REDIS_QUEUE_DB=15
REDIS_PREFIX="${APP_SLUG}_"

# Cache y sesión en array: los tests no deben depender de estado
# entre corridas ni dejar basura en Redis.
CACHE_STORE=array
CACHE_PREFIX="${APP_SLUG}_cache"

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_COOKIE="${APP_SLUG}_session"
SESSION_SERIALIZATION=json

QUEUE_CONNECTION=sync
HORIZON_PATH=horizon
HORIZON_PREFIX="${APP_SLUG}_horizon:"

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

MAIL_MAILER=array
MAIL_FROM_ADDRESS="no-reply@hospitallosangeles.hn"
MAIL_FROM_NAME="${APP_NAME}"

# Sin DSN: los tests nunca reportan a Sentry.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_PATH=
BROWSERSHOT_NO_SANDBOX=true

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME="Administrador"

VITE_APP_NAME="${APP_NAME}"
